# Vault Environment Variables Template (Zero-Trust Configuration)
# NUNCA insira chaves reais ou segredos de produção neste arquivo.
# Na VPS de produção, configure as variáveis diretamente no arquivo .env com permissão 600.

NODE_ENV=production
PORT=3000
APP_URL=https://stream.ecolive.com.br

# LiveKit SFU Cluster
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=wss://your_public_domain_here

# Discord Developer Application
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# Criptografia e Autenticação Zero-Trust (HMAC-SHA256)
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SECRET=your_secure_admin_hmac_secret_here
SESSION_SECRET=your_secure_user_session_hmac_secret_here
