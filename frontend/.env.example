# EcoLive Frontend Environment - Example Template
# Replace these values with your actual configuration
NODE_ENV=development
PORT=3000

# LiveKit SFU Cluster
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_minimum_32_characters
LIVEKIT_URL=https://your-livekit-domain.example.com
LIVEKIT_PUBLIC_URL=wss://your-livekit-domain.example.com
NEXT_PUBLIC_LIVEKIT_HOST=your-livekit-domain.example.com

# Discord Developer Application
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Security and Authentication (HMAC-SHA256)
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SECRET=your_random_64_character_hex_secret_here
SESSION_SECRET=your_random_64_character_hex_secret_here
